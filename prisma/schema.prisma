// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  name              String
  phone             String?
  role              UserRole  @default(CLIENT)
  resetToken        String?   @map("reset_token")
  resetTokenExpiry  DateTime? @map("reset_token_expiry")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  orders        Order[]
  folders       Folder[]

  @@map("users")
}

enum UserRole {
  CLIENT
  ADMIN
}

model Order {
  id            String      @id @default(uuid())
  userId        String?     @map("user_id")
  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Guest order email (for orders created before account)
  guestEmail        String?     @map("guest_email")
  completionToken   String?     @map("completion_token")

  // Order details
  orderNumber   String?     @map("order_number")
  fromLanguage  String      @map("from_language")
  toLanguage    String      @map("to_language")
  documentType  String      @map("document_type")
  serviceType   String      @map("service_type")
  wordCount     Int         @map("word_count")
  totalPrice    Float       @map("total_price")
  needsPricing  Boolean     @default(false) @map("needs_pricing")
  status        OrderStatus @default(NEW)
  isPaid        Boolean     @default(false) @map("is_paid")
  paymentIntentId String?   @map("payment_intent_id")

  // File information (stored as JSON)
  files         Json        @default("[]")

  // Translated file information
  translatedFileData String?   @map("translated_file_data") @db.Text
  translatedFileName String?   @map("translated_file_name")
  translatedFileType String?   @map("translated_file_type")

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@index([guestEmail])
  @@map("orders")
}

enum OrderStatus {
  NEW
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model Folder {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  status        FolderStatus  @default(NEW)
  isPaid        Boolean       @default(false) @map("is_paid")
  isArchived    Boolean       @default(false) @map("is_archived")

  // Files stored as JSON array
  files         Json          @default("[]")

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@map("folders")
}

enum FolderStatus {
  NEW
  PENDING
  COMPLETED
}
