# Copy to .env.local for local development. On Vercel, set these under
# Project Settings -> Environment Variables.

# --- File uploads (Vercel Blob, PRIVATE store) ---
# Created automatically when you connect a Blob store to the project
# (Storage tab -> Create -> Blob -> access: Private).
BLOB_READ_WRITE_TOKEN=

# Optional: secret used to sign document download links in notification emails.
# Defaults to BLOB_READ_WRITE_TOKEN. Generate with: openssl rand -base64 32
FILE_LINK_SECRET=

# --- SMTP (sends quote/contact form emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@azglobaltranslations.com
SMTP_FROM_NAME=AZ Global Translations

# Where form submissions are delivered (defaults to info@azglobaltranslations.com)
REQUEST_NOTIFY_EMAIL=

# --- Housekeeping ---
# Vercel sends this automatically to the daily cleanup cron. Generate with: openssl rand -hex 32
CRON_SECRET=
# Uploaded documents older than this are deleted (matches the privacy policy)
UPLOAD_RETENTION_DAYS=90

# --- Site URL (used in email links in production) ---
NEXT_PUBLIC_APP_URL=https://azglobaltranslations.com
